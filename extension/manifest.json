{
  "manifest_version": 3,
  "name": "TabPilot",
  "version": "0.4.0",
  "description": "Let your local AI agent drive a dedicated, visible tab group in your own logged-in browser.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "TabPilot"
  }
}