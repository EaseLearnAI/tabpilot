{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*tabpilot.*",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node --no-warnings \"${PLUGIN_ROOT}\\scripts\\hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"${PLUGIN_ROOT}/scripts/hook.mjs\"",
            "commandWindows": "node --no-warnings \"${PLUGIN_ROOT}\\scripts\\hook.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
